# paper (default, simulated) or live (real orders; each order also needs confirm=true)
TRADING_MODE=paper

# Option A: path to the JSON key file downloaded from portal.cdp.coinbase.com
COINBASE_KEY_FILE=

# Option B: paste the key directly
# COINBASE_API_KEY=organizations/.../apiKeys/...
# COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
